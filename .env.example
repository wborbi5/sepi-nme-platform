# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.

# --- Supabase -------------------------------------------------------------
# Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS. Never prefix this with NEXT_PUBLIC_,
# never import it into a client component, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# Used for magic link redirects and absolute URLs in email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allowlist additions are restricted to this domain, validated server-side in
# the admin action. The allowed_emails table is the actual gate.
ALLOWED_EMAIL_DOMAIN=miamioh.edu

# --- Member assistant (/ask) ----------------------------------------------
# Optional. Without it the assistant falls back to deterministic ranking over
# member profiles — a good search box, not an error page.
ANTHROPIC_API_KEY=

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="SEPi NME <noreply@yourdomain.org>"
EMAIL_REPLY_TO=

# --- Cron -----------------------------------------------------------------
# Long random string. Vercel Cron routes reject requests without it.
CRON_SECRET=
